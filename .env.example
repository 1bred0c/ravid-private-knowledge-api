# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + pgvector (Docker Compose service: db)
POSTGRES_DB=ravid
POSTGRES_USER=ravid
POSTGRES_PASSWORD=ravid
DATABASE_URL=postgresql://ravid:ravid@db:5432/ravid
LANGCHAIN_PG_CONNECTION=postgresql+psycopg://ravid:ravid@db:5432/ravid

# Redis (Docker Compose service: redis)
REDIS_URL=redis://redis:6379/0

# OpenRouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_HYDE_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=RAVID Private Knowledge API

# Retrieval and generation
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVAL_K=5
RAG_MAX_OUTPUT_TOKENS=1000
HYDE_MAX_OUTPUT_TOKENS=400
HYDE_TIMEOUT_SECONDS=20

# VNPay sandbox (optional unless payment flow is being demonstrated)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payments/vnpay/return/
VNPAY_IPN_URL=http://127.0.0.1:8000/api/payments/vnpay/ipn/
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
# Enables a signed browser return to activate payments during localhost demos.
# Set False in production and use VNPay's server-to-server IPN as authority.
VNPAY_PROCESS_RETURN=True

# Alternative names accepted by the backend for compatibility with VNPay samples:
# VNP_TMNCODE=
# VNP_HASHSECRET=

# When Django/Celery run on the host instead of Docker, replace db and redis
# above with 127.0.0.1 while keeping PostgreSQL and Redis containers running.
